# Server
PORT=3000
NODE_ENV=development

# Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# JWT Secrets
JWT_ACCESS_SECRET=my-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=my-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d